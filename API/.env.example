# Copy to API/.env and fill in. API/.env is git-ignored.
ROBOFLOW_API_KEY=your-roboflow-api-key
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY='replace-with-a-long-random-string'
# Optional: folder containing Poppler's pdftoppm, if Poppler isn't on PATH.
# Windows builds: https://github.com/oschwartz10612/poppler-windows/releases (use the Library\bin folder).
# POPPLER_PATH='C:\path\to\poppler\Library\bin'
